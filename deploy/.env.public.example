# Copy to deploy/.env.public ON THE TARGET SERVER, chmod 600, then edit.
# Never commit the private file or share it in chat, screenshots or diagnostics.
# DNS hostname only, e.g. funding.YOUR-REGISTERED-DOMAIN.tld.
# No scheme, port, path, whitespace, newline, localhost, IP or example domains.
APP_DOMAIN=

# Generate ONCE on the server; retain the same value with every DB backup.
# This is an application order-token secret, NOT a wallet private key.
ORDER_TOKEN_SECRET=

# Fill your own provider credentials privately. Public access is not guaranteed.
# Single-quote values containing '$' to prevent Compose interpolation.
RELAY_API_KEY=
TRONGRID_API_KEY=
# Optional public Reown dashboard project ID (32 hex characters), exposed by /api/config.
# Allowlist the real HTTPS origin in the dashboard. Empty leaves injected wallets usable.
WALLETCONNECT_PROJECT_ID=
# Optional first-party analytics; do not use wallet addresses or other personal data as labels.
ATTRIBUTION_ENABLED=false
ATTRIBUTION_CAMPAIGNS=
# Server-only Ethereum mainnet HTTPS RPC. Keep any URL API token private.
ETHEREUM_RPC_URL=https://ethereum.publicnode.com
ARBITRUM_RPC_URL=https://arbitrum-one.publicnode.com
BASE_RPC_URL=https://base.drpc.org
OPTIMISM_RPC_URL=https://optimism.publicnode.com
POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
BNB_RPC_URL=https://bsc-rpc.publicnode.com

# Start paused for HTTPS / environment checks. Change only for supervised tests.
PAUSE_NEW_ORDERS=true
MIN_AMOUNT=10
MAX_AMOUNT=100

# Absolute host path, pre-created with permissions for container UID/GID 1000.
# Contains private order DB snapshots; keep outside the source release folder.
BACKUP_DIR=/var/backups/perpdock

# PUBLIC_ORIGIN is derived by Compose from APP_DOMAIN. Do not set it separately.
# TRUST_PROXY_HOPS is fixed to 1; this topology must be Internet -> Caddy -> app.
