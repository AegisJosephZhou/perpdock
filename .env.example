# Local development reads .env. Never put private keys or seed phrases here.
HOST=127.0.0.1
PORT=8787
DATA_DIR=./data
APP_NAME=Perpex
# Optional public Reown dashboard project ID (32 hex characters), exposed by /api/config.
# Leave empty to retain injected wallets only. Restrict production origins in the dashboard.
WALLETCONNECT_PROJECT_ID=
# Optional first-party analytics; disabled unless true plus an approved campaign allowlist.
ATTRIBUTION_ENABLED=false
ATTRIBUTION_CAMPAIGNS=
# Optional error/funnel monitoring. Configure after release approval; all default off.
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# Optional immutable Git SHA or semantic version; no customer identifiers.
SENTRY_RELEASE=
FUNNEL_ENABLED=false
# Keep false for local SQLite-only funnel collection.
POSTHOG_ENABLED=false
POSTHOG_PROJECT_KEY=
POSTHOG_HOST=https://us.i.posthog.com
MIN_AMOUNT=10
MAX_AMOUNT=1000
PAUSE_NEW_ORDERS=false

# Required for NODE_ENV=production. Generate a stable random secret with:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# Store it in your deployment secret manager. Back it up with the database.
ORDER_TOKEN_SECRET=
PUBLIC_ORIGIN=
# Only set to 1 behind one trusted reverse proxy with no direct public access.
TRUST_PROXY_HOPS=

# Public read-only calls worked during development. Provider policy can change.
# Configure your own keys for a market test; never expose them in client code.
RELAY_API_KEY=
TRONGRID_API_KEY=
# Server-only Ethereum mainnet HTTPS RPC. Keep any URL API token private.
ETHEREUM_RPC_URL=https://ethereum.publicnode.com
ARBITRUM_RPC_URL=https://arbitrum-one.publicnode.com
BASE_RPC_URL=https://base.drpc.org
OPTIMISM_RPC_URL=https://optimism.publicnode.com
POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
BNB_RPC_URL=https://bsc-rpc.publicnode.com
# Server-only Solana mainnet RPC used for finalized source verification. Never expose URL API keys.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
